# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# API key Gemini — lấy tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Giữ = 0 nếu dùng Google AI Studio (không dùng Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=0

# OpenAI — dùng khi chọn ChatGPT 4o mini
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
